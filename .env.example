# Copy the variables below into your process environment for deployment.
TEXTSEAL_SECRET_KEY=replace-with-a-long-django-secret
TEXTSEAL_WATERMARK_SECRET=replace-with-a-long-random-watermark-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=example.org

# This prototype records local references. Do not label them blockchain transactions.
BLOCKCHAIN_MODE=local
